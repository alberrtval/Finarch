<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cl_secundario"
    tools:context=".ui.ModificarCategoria">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_arrow_back_24"
            app:tint="@color/cl_text_ter"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finarch"
                android:fontFamily="@font/rock_regular"
                android:textColor="@color/cl_divisor"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis categorías"
                android:textColor="@color/cl_text_ter"
                android:textSize="13sp"
                android:fontFamily="@font/inter_regular"
                android:letterSpacing="0.03"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollCategorias"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Card nueva categoría -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNuevaCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/cl_principal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nueva categoría"
                        android:textColor="@color/cl_texto_sec"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNombreCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nombre de categoría"
                        android:textColorHint="@color/cl_text_ter"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="@color/cl_principalSc"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:hintTextColor="@color/cl_text_ter"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombreCategoria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:textColor="@color/cl_texto_princ"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_regular"
                            android:padding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPresupuesto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Presupuesto mensual (opcional)"
                        android:textColorHint="@color/cl_text_ter"
                        app:startIconDrawable="@drawable/ic_attach_money_24"
                        app:startIconTint="@color/cl_text_ter"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="@color/cl_principalSc"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:hintTextColor="@color/cl_text_ter"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPresupuesto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:textColor="@color/cl_texto_princ"
                            android:textSize="15sp"
                            android:fontFamily="@font/inter_regular"
                            android:padding="12dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Contador y botón agregar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvContador"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0 / 5 categorías"
                            android:textColor="@color/cl_text_ter"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAgregarCategoria"
                            style="@style/FinarchButton3D.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Agregar"
                            android:textColor="@color/cl_texto_princ"/>
                    </LinearLayout>

                    <!-- Mensaje límite alcanzado -->
                    <TextView
                        android:id="@+id/tvLimiteAlcanzado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Límite de categorías alcanzado"
                        android:textColor="@color/cl_error"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card lista de categorías -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardListaCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/cl_principal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mis categorías"
                        android:textColor="@color/cl_texto_sec"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginBottom="8dp"/>

                    <!-- Lista dinámica de categorías -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCategorias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>

                    <!-- Mensaje lista vacía -->
                    <TextView
                        android:id="@+id/tvSinCategorias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aún no tienes categorías"
                        android:textColor="@color/cl_text_ter"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:visibility="visible"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>